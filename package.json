{
  "name": "dynatrace-answers",
  "productName": "Dynatrace Answers",
  "version": "1.3.0",
  "description": "Operational insights for every team, powered by Dynatrace Intelligence",
  "main": "src/main.js",
  "author": "Dynatrace Answers",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/help.cjs && node test/checks.cjs && node test/infra.cjs && node test/formatting.cjs",
    "dist": "electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "com.dynatrace.answers",
    "productName": "Dynatrace Answers",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "guid": "628d508c-a007-5629-97a0-e53910f02cfa",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dynatrace Answers",
      "artifactName": "Dynatrace-Answers-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "pdfjs-dist": "^6.4.299"
  },
  "dependencies": {
    "lucide-static": "^1.66.0",
    "markdown-it": "^15.0.3",
    "sanitize-html": "^2.18.1"
  }
}
